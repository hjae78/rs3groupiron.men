generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Group {
  id                  String            @id @default(cuid())
  name                String            @unique
  /// Lower-cased name for case-insensitive lookups.
  nameKey             String            @unique @map("name_key")
  token               String
  mode                GroupMode         @default(normal)
  appearance          AppearanceTheme   @default(rs3)
  /// Fixed group capacity (2–5). Add only when below this.
  memberSlots         Int               @default(5) @map("member_slots")
  /// Coin value at or above which a drop is announced even when the item is
  /// not listed. 0 leaves the lists in sole charge.
  dropThreshold       Int               @default(20000000) @map("drop_threshold")
  visibility          GroupVisibility   @default(private)
  publicMap           Boolean           @default(false) @map("public_map")
  publicSkills        Boolean           @default(true) @map("public_skills")
  publicItems         Boolean           @default(true) @map("public_items")
  publicQuests        Boolean           @default(true) @map("public_quests")
  publicAchievements  Boolean           @default(true) @map("public_achievements")
  viewsTotal          Int               @default(0) @map("views_total")
  createdAt           DateTime          @default(now()) @map("created_at")
  deletionRequestedAt DateTime?         @map("deletion_requested_at")
  deleteAfter         DateTime?         @map("delete_after")
  members             Member[]
  viewDays            GroupViewDay[]
  /// Group-owned inventories, i.e. the shared bank.
  inventories         GroupInventory[]
  sharedBankEntries   SharedBankEntry[]
  achievements        Achievement[]
  rareItems           GroupRareItem[]

  @@index([visibility, nameKey])
  @@index([deleteAfter])
  @@map("groups")
}

enum GroupVisibility {
  private
  public
}

model GroupViewDay {
  id      String   @id @default(cuid())
  groupId String   @map("group_id")
  day     DateTime @db.Date
  views   Int      @default(0)

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, day])
  @@index([day])
  @@map("group_view_days")
}

/**
 * A group's own say on an item: `include` adds one the shared list misses,
 * `include = false` silences one it has. Absent means the shared list and the
 * group's value threshold decide.
 */
model GroupRareItem {
  id        String   @id @default(cuid())
  groupId   String   @map("group_id")
  itemId    Int      @map("item_id")
  include   Boolean  @default(true)
  /// Only announce a drop of this item when the stack falls in [minQty, maxQty].
  /// Null is open-ended, so both null means any amount. Only meaningful on an
  /// included row: an excluded item is silent at every size.
  minQty    Int?     @map("min_qty")
  maxQty    Int?     @map("max_qty")
  createdAt DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, itemId])
  @@index([groupId])
  @@map("group_rare_items")
}

enum AchievementKind {
  level
  drop
  quest
  diary
  other
}

/// Notable group moments: level milestones, drops, quests, diaries.
model Achievement {
  id         String          @id @default(cuid())
  groupId    String          @map("group_id")
  /// Member name as it was at the time; survives renames/removals.
  memberName String          @map("member_name")
  kind       AchievementKind
  /// Headline, e.g. "99 Slayer" or "Twisted bow".
  title      String
  detail     String?
  /// Skill id for level milestones (see skills.catalog.ts).
  skillId    String?         @map("skill_id")
  /// Item id for drops.
  itemId     Int?            @map("item_id")
  /// Stack size for drops, so the feed can draw the item the way the game
  /// does. Null for anything that is not a drop, or a drop from before this
  /// was stored; the title still carries "xN" for the reader.
  quantity   Int?
  /// RS3 gameval name for quests/diaries (e.g. quest_cooks_assistant).
  /// Stored instead of the cache id because names survive renumbering.
  gameval    String?
  /// Optional screenshot hosted on the CDN.
  imageUrl   String?         @map("image_url")
  /// Set for auto-detected milestones so they are recorded once only.
  dedupeKey  String?         @map("dedupe_key")
  achievedAt DateTime        @default(now()) @map("achieved_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, dedupeKey])
  @@index([groupId, achievedAt])
  @@map("achievements")
}

/// Append-only record of shared ("group") bank movements.
model SharedBankEntry {
  id         String   @id @default(cuid())
  groupId    String   @map("group_id")
  /// Member name as it was at the time; kept even if they are renamed or removed.
  memberName String   @map("member_name")
  itemId     Int      @map("item_id")
  /// Positive = deposited into the shared bank, negative = withdrawn.
  delta      Int
  createdAt  DateTime @default(now()) @map("created_at")

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@index([groupId, createdAt])
  @@map("shared_bank_entries")
}

enum GroupMode {
  normal
  competitive
}

enum AppearanceTheme {
  rs3
  modern
}

model Member {
  id               String    @id @default(cuid())
  groupId          String    @map("group_id")
  name             String
  nickname         String?
  discordId        String?   @map("discord_id")
  /// Hex map/panel colour, e.g. #4a8f3c. Null = hash from name.
  color            String?
  /// When true and discordId is set, show Discord avatar on map + left panel.
  useDiscordAvatar Boolean   @default(true) @map("use_discord_avatar")
  /// Plugin/client presence — offline members are hidden on the map.
  online           Boolean   @default(false)
  /// Opt-out from the live map. False hides this member's position from the
  /// rest of the group without touching their online flag or any other panel.
  shareLocation    Boolean   @default(true) @map("share_location")
  /// Logged in but sitting on the lobby screen: online, with no position.
  inLobby          Boolean   @default(false) @map("in_lobby")
  /// What this member is currently fighting, straight from the target panel.
  /// Cleared when they stop; treated as stale by readers after a short while.
  targetName       String?   @map("target_name")
  targetHp         Int?      @map("target_hp")
  targetPercent    Int?      @map("target_percent")
  targetAt         DateTime? @map("target_at")
  /// Running total across every NPC, kept here so a member list needs no
  /// aggregate query.
  npcKillsTotal    Int       @default(0) @map("npc_kills_total")
  /// When the plugin last sent a full login baseline. The site compares this
  /// between polls: a jump that lands on a new baseline is catch-up, not a
  /// gain, so it must not surface as an XP drop.
  baselineAt       DateTime? @map("baseline_at")
  /// Any change at all: position, vitals, online flag, profile, inventories.
  lastUpdated      DateTime  @default(now()) @map("last_updated")
  /// Only the expensive payload: inventories and skills. A position ping bumps
  /// lastUpdated but not this, so a delta poll can send the member's new
  /// coordinates without resending their bank. See getGroupData(split).
  dataUpdatedAt    DateTime  @default(now()) @map("data_updated_at")
  hpCurrent        Int       @default(0) @map("hp_current")
  hpMax            Int       @default(0) @map("hp_max")
  prayerCurrent    Int       @default(0) @map("prayer_current")
  prayerMax        Int       @default(0) @map("prayer_max")
  summonCurrent    Int       @default(0) @map("summon_current")
  summonMax        Int       @default(0) @map("summon_max")
  /// Carried weight in kilograms, as the game shows it. Float because it has a
  /// decimal, and signed because weight-reducing gear takes it below zero.
  weight           Float     @default(0)
  world            Int       @default(0)
  x                Int       @default(0)
  y                Int       @default(0)
  plane            Int       @default(0)
  /// Restrict (not Cascade): a Player must have its Members cleared first —
  /// see PlayerDeletionService.
  playerId         String    @map("player_id")

  group                 Group                    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  player                Player                   @relation(fields: [playerId], references: [id], onDelete: Restrict)
  inventories           MemberInventory[]
  skills                MemberSkill[]
  xpSamples             SkillXpSample[]
  quests                MemberQuest[]
  completedAchievements MemberAchievement[]
  achievementTallies    MemberAchievementTally[]
  npcKills              MemberNpcKill[]

  @@unique([groupId, name])
  @@index([groupId])
  @@index([playerId])
  @@map("members")
}

enum PlayerVerificationStatus {
  unverified
  plugin_verified
}

/// Global, cross-group player identity; a Player can have zero or more
/// Members across different groups.
model Player {
  id                 String                   @id @default(cuid())
  currentUsername    String                   @map("current_username")
  /// Lower-cased, for case-insensitive lookups. Only unique among verified
  /// players, via a partial unique index in the migration SQL (Prisma's
  /// schema syntax can't express that directly).
  usernameKey        String                   @map("username_key")
  verificationStatus PlayerVerificationStatus @default(unverified) @map("verification_status")
  verifiedAt         DateTime?                @map("verified_at")
  /// Hash of the plugin's Player.GetTrackingID() at the moment this player
  /// verified. Lets a later membership with the same username auto-verify
  /// once it reports a matching tracking id, without redoing the code flow.
  trackingIdHash     String?                  @map("tracking_id_hash")
  createdAt          DateTime                 @default(now()) @map("created_at")
  updatedAt          DateTime                 @updatedAt @map("updated_at")

  /// Same shape as Group.deletionRequestedAt/deleteAfter: a 24h cancellable
  /// window, swept by the same GroupPurgeService that already handles groups.
  deletionRequestedAt DateTime? @map("deletion_requested_at")
  deleteAfter         DateTime? @map("delete_after")

  members            Member[]
  usernameHistory    PlayerUsernameHistory[]
  verificationTokens PlayerVerificationToken[]
  accessCredentials  PlayerAccessCredential[]

  @@index([usernameKey])
  @@index([usernameKey, trackingIdHash])
  @@index([deleteAfter])
  @@map("players")
}

/// Point-in-time record of every username a Player has gone by, independent
/// of the group-scoped Achievement/SharedBankEntry name snapshots.
model PlayerUsernameHistory {
  id          String   @id @default(cuid())
  playerId    String   @map("player_id")
  username    String
  firstSeenAt DateTime @default(now()) @map("first_seen_at")
  lastSeenAt  DateTime @default(now()) @map("last_seen_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([playerId])
  @@map("player_username_history")
}

/// Single-use, plugin-requested proof that this group's token was used while
/// logged in as this member — not cryptographic account ownership, since the
/// plugin API exposes no stable account id, only the display name. Only
/// tokenHash is stored; the plaintext is returned once and never persisted.
model PlayerVerificationToken {
  id             String    @id @default(cuid())
  playerId       String    @map("player_id")
  /// Snapshot fields for audit only, not FKs (mirrors Achievement.memberName)
  /// so a later group/member rename or deletion can't orphan anything here.
  groupId        String    @map("group_id")
  memberId       String    @map("member_id")
  tokenHash      String    @map("token_hash")
  /// Carries the plugin's tracking id hash from request through to redeem,
  /// since redemption happens in the browser with no plugin access of its own.
  trackingIdHash String?   @map("tracking_id_hash")
  expiresAt      DateTime  @map("expires_at")
  consumedAt     DateTime? @map("consumed_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([playerId])
  @@map("player_verification_tokens")
}

/// A revocable, rotatable session credential issued once verification
/// succeeds — separate from PlayerVerificationToken because proving
/// ownership and acting afterwards are different concerns.
model PlayerAccessCredential {
  id         String    @id @default(cuid())
  playerId   String    @map("player_id")
  tokenHash  String    @map("token_hash")
  /// Forward-compatible with finer-grained scopes later; only "portal"
  /// exists today and nothing yet checks its value beyond presence.
  scopes     String[]  @default(["portal"])
  expiresAt  DateTime  @map("expires_at")
  revokedAt  DateTime? @map("revoked_at")
  lastUsedAt DateTime? @map("last_used_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  player Player @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@index([tokenHash])
  @@index([playerId])
  @@map("player_access_credentials")
}

/// Tombstone: a short cooldown on re-verifying a username after deletion,
/// not an identity record. No FK to Player (it's gone); the hash is an
/// exact-match lookup key only, not a claim of anonymization.
model DeletionSuppression {
  id              String   @id @default(cuid())
  usernameKeyHash String   @map("username_key_hash")
  suppressedAt    DateTime @default(now()) @map("suppressed_at")
  cooldownUntil   DateTime @map("cooldown_until")

  @@index([usernameKeyHash])
  @@map("deletion_suppressions")
}

/// An inventory a member owns, keyed by its RS3 inv gameval (inv, worn,
/// bank, money_pouch, ...). The plugin's inventory, equipment and bank are
/// each one of these; contents live in MemberInventoryItem.
model MemberInventory {
  id          String   @id @default(cuid())
  memberId    String   @map("member_id")
  key         String
  updatedAt   DateTime @default(now()) @map("updated_at")
  /// Hash of the current contents. A sync whose hash matches is skipped
  /// entirely, so an unchanged 4000-item bank costs one SELECT instead of
  /// deleting and reinserting every row. Null means "never hashed" and
  /// forces one rewrite.
  contentHash String?  @map("content_hash")

  member Member                @relation(fields: [memberId], references: [id], onDelete: Cascade)
  items  MemberInventoryItem[]

  @@unique([memberId, key])
  @@map("member_inventories")
}

/// A slot in a member inventory. Slots are positional for `inv`; other
/// inventories only store occupied slots.
model MemberInventoryItem {
  id          String @id @default(cuid())
  inventoryId String @map("inventory_id")
  slot        Int
  itemId      Int    @map("item_id")
  quantity    Int    @default(0)

  inventory MemberInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, slot])
  @@map("member_inventory_items")
}

/// An inventory the group owns rather than a member: the shared bank lives
/// here under the `bank` key. Same shape as a member inventory.
model GroupInventory {
  id          String   @id @default(cuid())
  groupId     String   @map("group_id")
  key         String
  updatedAt   DateTime @default(now()) @map("updated_at")
  /// See MemberInventory.contentHash. Skipping the write also leaves
  /// updatedAt alone, which keeps an unchanged shared bank out of every
  /// get-group-data delta.
  contentHash String?  @map("content_hash")

  group Group                @relation(fields: [groupId], references: [id], onDelete: Cascade)
  items GroupInventoryItem[]

  @@unique([groupId, key])
  @@map("group_inventories")
}

model GroupInventoryItem {
  id          String @id @default(cuid())
  inventoryId String @map("inventory_id")
  slot        Int
  itemId      Int    @map("item_id")
  quantity    Int    @default(0)

  inventory GroupInventory @relation(fields: [inventoryId], references: [id], onDelete: Cascade)

  @@unique([inventoryId, slot])
  @@map("group_inventory_items")
}

/// Only quests a member has touched are stored; no row means not started.
enum QuestState {
  started
  finished
}

/// Per-member quest progress keyed by the quest's RS3 gameval name
/// (e.g. cooks_assistant), which survives cache renumbering. Everything
/// static about a quest (name, points, requirements) lives in the client's
/// quest dump, so nothing else is stored here.
model MemberQuest {
  id        String     @id @default(cuid())
  memberId  String     @map("member_id")
  gameval   String
  state     QuestState
  updatedAt DateTime   @default(now()) @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, gameval])
  @@map("member_quests")
}

/// Achievements and diaries a member has completed, keyed by the RS3
/// gameval name so a cache renumbering cannot reattribute one. Presence is
/// completion: there is no row for an incomplete achievement.
/**
 * Progress towards an achievement that counts something ("kill 50 goblins").
 * Separate from MemberAchievement, where a row means finished: these come and
 * go while the count climbs, and are cleared once it is done.
 */
/**
 * How many of each NPC a member has killed. One row per member per name, so
 * the running totals stay cheap to read and to add to.
 */
model MemberNpcKill {
  id       String   @id @default(cuid())
  memberId String   @map("member_id")
  npcName  String   @map("npc_name")
  kills    Int      @default(0)
  lastAt   DateTime @default(now()) @map("last_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, npcName])
  @@index([memberId])
  @@map("member_npc_kills")
}

model MemberAchievementTally {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  gameval   String
  progress  Int      @default(0)
  target    Int      @default(0)
  updatedAt DateTime @default(now()) @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, gameval])
  @@index([memberId])
  @@map("member_achievement_tallies")
}

model MemberAchievement {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  gameval   String
  updatedAt DateTime @default(now()) @map("updated_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, gameval])
  @@map("member_achievements")
}

/// Per-member RS3 skill XP/levels (max XP 200m; max level 99/110/120 per skill)
model MemberSkill {
  id        String @id @default(cuid())
  memberId  String @map("member_id")
  skillId   String @map("skill_id")
  xp        BigInt @default(0)
  /// Boosted / current level shown in UI
  level     Int    @default(1)
  /// Unboosted base level
  baseLevel Int    @default(1) @map("base_level")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, skillId])
  @@index([memberId])
  @@map("member_skills")
}

/// Time-series XP samples for graphs (indexed for period/skill queries)
model SkillXpSample {
  id        String   @id @default(cuid())
  memberId  String   @map("member_id")
  skillId   String   @map("skill_id")
  xp        BigInt
  sampledAt DateTime @map("sampled_at")

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId, skillId, sampledAt])
  @@index([memberId, sampledAt])
  @@index([sampledAt])
  @@map("skill_xp_samples")
}
